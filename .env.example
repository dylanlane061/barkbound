DATABASE_URL=postgresql://user:password@localhost:5432/barkbound

# Google Places API (New) — canonical place catalog (server-side: Nearby + Details).
# Server key; keep it secret. Restrict to the Places API (New) in Cloud Console.
GOOGLE_MAPS_API_KEY=

# Browser key for the <gmpx-place-picker> search box (client-side, exposed in the page).
# MUST be locked down with HTTP referrer restrictions in Cloud Console, and restricted
# to the Maps JavaScript API + Places API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Anthropic API — Claude-backed website pet-policy extraction (PawSignal Sources
# Plan, Phase A). Optional: if unset, extraction falls back to the pure regex
# matcher automatically. Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional override for the extraction model (defaults to a Claude Haiku model).
# PAWSIGNAL_LLM_MODEL=claude-haiku-4-5-20251001

# Mine Google reviews for first-hand dog mentions (PawSignal Sources Plan, Phase
# B). OFF by default: reviews promote the Place Details call to the pricier
# Enterprise+Atmosphere SKU (free up to ~1k/month). Set to 1 to enable. Requires
# ANTHROPIC_API_KEY too (reviews are extracted by the LLM, not regex).
# PAWSIGNAL_GOOGLE_REVIEWS=1

# Pipeline step logging is ON automatically in development.
# Set to 1 to force it on elsewhere (e.g. a deployed preview).
# DEBUG_PIPELINE=1
